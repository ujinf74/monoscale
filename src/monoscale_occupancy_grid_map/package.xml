<?xml version="1.0"?>
<package format="3">
  <name>monoscale_occupancy_grid_map</name>
  <version>0.1.0</version>
  <description>An occupancy grid accumulated from the labelled ground points the odometry publishes.</description>
  <maintainer email="ujin@tukorea.ac.kr">Ujin Kwon</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/ujinf74/monoscale</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
