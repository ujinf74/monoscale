Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Vision occupancy1
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 160; 160; 164
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 2
    - Class: rviz_default_plugins/Map
      Name: Vision occupancy
      Enabled: true
      Topic:
        Value: /vision/occupancy_grid
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Name: LiDAR reference occupancy
      Enabled: false
      Topic:
        Value: /reference/occupancy_grid
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: costmap
      Draw Behind: true
      Alpha: 0.5
    - Class: rviz_default_plugins/Path
      Name: Estimated path
      Enabled: true
      Topic:
        Value: /vision/evaluation/estimate_path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 200; 255
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: Ground truth path
      Enabled: true
      Topic:
        Value: /vision/evaluation/truth_path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 170; 0
      Line Style: Lines
    - Class: rviz_default_plugins/Image
      Name: Front camera
      Enabled: true
      Topic:
        Value: /sensing/camera/front/vio/image_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Rear camera
      Enabled: false
      Topic:
        Value: /sensing/camera/rear/vio/image_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Normalize Range: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 45
      Pitch: 1.0
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: base_link
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  Displays:
    collapsed: false
